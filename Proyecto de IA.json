    {
      "parameters": {
        "jsCode": "const nombre = $('Webhook').first().json.body.nombre;\nconst motivo = $('Webhook').first().json.body.motivo;\nconst descripcion = $('Webhook').first().json.body.descripcion || \"No proporcionada\";\n\nconst prompt = `Clasifica esta justificación de inasistencia académica.\n\nEstudiante: ${nombre}\nMotivo: ${motivo}\nDescripción: ${descripcion}\n\nReglas:\n- VALIDA: enfermedad, duelo, trámite oficial, accidente\n- INVALIDA: motivo claramente inaceptable\n- DUDOSA: información insuficiente o contradictoria\n\nResponde solo con este JSON:\n{\"clasificacion\": \"VALIDA\", \"confianza\": 0.80, \"razon\": \"breve\"}`;\n\nconst body = {\n  contents: [{ parts: [{ text: prompt }] }],\n  generationConfig: { temperature: 0.1, maxOutputTokens: 2050 }\n};\n\nreturn [{ json: { body: JSON.stringify(body) } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        32,
        256
      ],
      "id": "ca129c8a-ae13-4aa8-b3b7-3a8844d983b9",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=AIzaSyC5MmD7GIwNhbD9iqtBiMa6i40UTaH_Vio",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {}
      },
