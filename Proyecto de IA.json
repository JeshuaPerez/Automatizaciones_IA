      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "// Extraer el texto de la respuesta de Gemini\nconst texto = $json.candidates[0].content.parts[0].text;\n\n// Limpiar los bloques de código markdown que Gemini agrega\nconst limpio = texto.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n\n// Parsear el JSON\nconst resultado = JSON.parse(limpio);\n\n// Corregir confianza 0 por error de Gemini\nif (resultado.confianza === 0) resultado.confianza = 0.85;\n\n// Traer también los datos originales del estudiante\nconst nombre = $('Webhook').first().json.body.nombre;\nconst id_estudiante = $('Webhook').first().json.body.id_estudiante;\nconst telegram_id = $('Webhook').first().json.body.telegram_id;\nconst id_solicitud = $('Append row in sheet').first().json.ID_solicitud;\n\nreturn [{\n  json: {\n    clasificacion: resultado.clasificacion,\n    confianza: resultado.confianza,\n    razon: resultado.razon,\n    nombre,\n    id_estudiante,\n    telegram_id,\n    id_solicitud\n  }\n}];"
      },
