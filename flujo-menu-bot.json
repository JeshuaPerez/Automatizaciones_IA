    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst messageText = $('Telegram Trigger').first().json.message?.text || '';\nconst match = messageText.match(/\\/consultar\\s+(\\S+)/);\nconst searchId = match ? match[1].trim() : '';\n\nif (!searchId) {\n  return [{ json: { text: '\\u274C Por favor incluye el ID de solicitud.\\nEjemplo: /consultar 1748823000000' } }];\n}\n\nconst row = rows.find(r => String(r.json.ID_solicitud) === searchId);\n\nif (!row) {\n  return [{ json: { text: '\\u274C No se encontr\\u00F3 ninguna solicitud con ID: ' + searchId + '\\n\\nVerifica que el ID sea correcto.' } }];\n}\n\nconst j = row.json;\nconst fecha = j.Fecha ? j.Fecha.substring(0, 10) : '-';\nconst confianza = j.Nivel_confianza ? Math.round(parseFloat(j.Nivel_confianza) * 100) + '%' : '-';\n\nconst estadoEmoji = {\n  'Aprobado': '\\u2705',\n  'Rechazado': '\\u274C',\n  'En_proceso': '\\uD83D\\uDD0D',\n  'pendiente': '\\u23F3'\n};\nconst emoji = estadoEmoji[j.Estado] || '\\uD83D\\uDCCB';\n\nconst text =\n  '\\uD83D\\uDCCB *Solicitud #' + j.ID_solicitud + '*\\n\\n' +\n  '\\uD83D\\uDC64 Estudiante: ' + (j.Nombre || '-') + '\\n' +\n  '\\uD83D\\uDCC5 Fecha: ' + fecha + '\\n' +\n  '\\uD83D\\uDCDD Motivo: ' + (j.Motivo || '-') + '\\n\\n' +\n  '\\uD83E\\uDD16 Resultado IA: ' + (j.Resultado_IA || 'Pendiente') + '\\n' +\n  '\\uD83D\\uDCCA Confianza: ' + confianza + '\\n\\n' +\n  emoji + ' Estado actual: *' + (j.Estado || '-') + '*';\n\nreturn [{ json: { text: text } }];"
      },
