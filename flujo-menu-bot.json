        "jsCode": "const rows = $input.all();\nconst total = rows.length;\nconst aprobadas = rows.filter(r => r.json.Estado === 'Aprobado').length;\nconst rechazadas = rows.filter(r => r.json.Estado === 'Rechazado').length;\nconst revision = rows.filter(r => r.json.Estado === 'En_proceso').length;\nconst pendientes = rows.filter(r => r.json.Estado === 'pendiente').length;\n\nconst text =\n  '\\uD83D\\uDCCA *Resumen de justificaciones*\\n\\n' +\n  '\\u2705 Aprobadas: ' + aprobadas + '\\n' +\n  '\\u274C Rechazadas: ' + rechazadas + '\\n' +\n  '\\uD83D\\uDD0D En revisi\\u00F3n: ' + revision + '\\n' +\n  '\\u23F3 Pendientes: ' + pendientes + '\\n\\n' +\n  '\\uD83D\\uDCC1 Total registradas: *' + total + '*';\n\nreturn [{ json: { text: text } }];"
      },
