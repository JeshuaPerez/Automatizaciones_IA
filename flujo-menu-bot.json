    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nconst pendientes = rows.filter(r =>\n  r.json.Estado === 'pendiente' || r.json.Estado === 'En_proceso'\n);\n\nif (pendientes.length === 0) {\n  return [{ json: { text: '\\u2705 No hay justificaciones pendientes en este momento.' } }];\n}\n\nlet text = '\\u23F3 *Justificaciones pendientes/en revisi\\u00F3n* (' + pendientes.length + '):\\n\\n';\npendientes.forEach((r, i) => {\n  const fecha = r.json.Fecha ? r.json.Fecha.substring(0, 10) : '-';\n  const estado = r.json.Estado === 'En_proceso' ? '\\uD83D\\uDD0D En revisi\\u00F3n' : '\\u23F3 Pendiente';\n  text += (i + 1) + '. *' + (r.json.Nombre || '-') + '*\\n';\n  text += '   ID: ' + (r.json.ID_solicitud || '-') + '\\n';\n  text += '   Fecha: ' + fecha + '\\n';\n  text += '   Estado: ' + estado + '\\n\\n';\n});\n\nreturn [{ json: { text: text } }];"
      },
