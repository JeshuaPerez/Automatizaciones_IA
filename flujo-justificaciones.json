    {
      "parameters": {
        "jsCode": "let resultado;\ntry {\n  const texto = $json.candidates[0].content.parts[0].text;\n  const limpio = texto.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  resultado = JSON.parse(limpio);\n  if (!resultado.confianza || resultado.confianza === 0) resultado.confianza = 0.85;\n} catch (e) {\n  // JSON malformado o respuesta vacia de Gemini — clasificar como DUDOSA preventivamente\n  resultado = {\n    clasificacion: 'DUDOSA',\n    confianza: 0.3,\n    razon: 'Error al procesar respuesta de IA — revision manual requerida'\n  };\n}\n\nconst nombre = $('Webhook').first().json.body.nombre;\nconst id_estudiante = $('Webhook').first().json.body.id_estudiante;\nconst telegram_id = $('Webhook').first().json.body.telegram_id;\nconst id_solicitud = $('Append row in sheet').first().json.ID_solicitud;\n\nreturn [{\n  json: {\n    clasificacion: resultado.clasificacion,\n    confianza: resultado.confianza,\n    razon: resultado.razon,\n    nombre,\n    id_estudiante,\n    telegram_id,\n    id_solicitud\n  }\n}];"
      },
