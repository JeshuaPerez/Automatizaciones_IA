    {
      "parameters": {
        "jsCode": "const nombre = $('Webhook').first().json.body.nombre;\nconst motivo = $('Webhook').first().json.body.motivo;\nconst descripcion = $('Webhook').first().json.body.descripcion || 'No proporcionada';\n\nconst basePrompt =\n  'Clasifica esta justificacion de inasistencia academica.\\n\\n' +\n  'Estudiante: ' + nombre + '\\n' +\n  'Motivo: ' + motivo + '\\n' +\n  'Descripcion: ' + descripcion + '\\n\\n' +\n  'Reglas:\\n' +\n  '- VALIDA: enfermedad, duelo, tramite oficial, accidente\\n' +\n  '- INVALIDA: motivo claramente inaceptable\\n' +\n  '- DUDOSA: informacion insuficiente o contradictoria\\n\\n' +\n  'Responde SOLO con este JSON exacto (sin markdown, sin texto extra):\\n' +\n  '{\"clasificacion\": \"VALIDA\", \"confianza\": 0.80, \"razon\": \"breve explicacion\"}';\n\nlet parts = [{ text: basePrompt }];\n\n// Procesamiento de archivo adjunto\ntry {\n  const binary = $input.first().binary;\n  if (binary && binary.archivo) {\n    const mimeType = binary.archivo.mimeType;\n    if (mimeType === 'image/jpeg' || mimeType === 'image/png' || mimeType === 'image/webp') {\n      const buffer = await this.helpers.getBinaryDataBuffer(0, 'archivo');\n      const base64 = buffer.toString('base64');\n      parts.push({ inlineData: { mimeType: mimeType, data: base64 } });\n    } else if (mimeType === 'application/pdf') {\n      parts[0].text += '\\n\\n[El estudiante adjunto un documento PDF como comprobante]';\n    }\n  }\n} catch (e) {\n  // Sin archivo adjunto o error al procesarlo — continuar solo con texto\n}\n\nconst body = {\n  contents: [{ parts: parts }],\n  generationConfig: { temperature: 0.1, maxOutputTokens: 256 }\n};\n\nreturn [{ json: { body: JSON.stringify(body) } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
